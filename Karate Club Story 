{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNQzYGgm8q2q/IQZ+/X1CxI"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":19,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"b6aQhYRO3yG9","executionInfo":{"status":"ok","timestamp":1795446616571,"user_tz":-330,"elapsed":44,"user":{"displayName":"Ritheesh","userId":"16825785188976750571"}},"outputId":"f53a1576-38d3-4d6b-e3d6-ba986c639db4"},"outputs":[{"output_type":"stream","name":"stdout","text":["Loaded Zachary's Karate Club: 34 nodes, 78 edges.\n"]}],"source":["import networkx as nx\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","# Load Zachary's Karate Club graph\n","G_orig = nx.karate_club_graph()\n","nodes = list(G_orig.nodes())\n","N = len(nodes)\n","m = G_orig.number_of_edges()\n","\n","# Compute the global modularity matrix B\n","A = nx.to_numpy_array(G_orig, nodelist=nodes)\n","k = A.sum(axis=1)\n","B = A - np.outer(k, k) / (2.0 * m)\n","\n","# Fixed layout so node positions remain consistent across all visualizations\n","pos = nx.spring_layout(G_orig, seed=42)\n","\n","print(f\"Loaded Zachary's Karate Club: {N} nodes, {m} edges.\")"]},{"cell_type":"code","source":["def spectral_bisect(sub_indices, B_global, m_total, tol=1e-8):\n","    n_g = len(sub_indices)\n","    if n_g <= 1:\n","        return None\n","\n","    B_sub = B_global.take(sub_indices, axis=0).take(sub_indices, axis=1)\n","    row_sums = B_sub.sum(axis=1)\n","    B_sub = B_sub - np.diag(row_sums)\n","\n","    eigvals, eigvecs = np.linalg.eigh(B_sub)\n","    max_idx = int(np.argmax(eigvals))\n","    beta_1 = float(eigvals.item(max_idx))\n","    u_1 = eigvecs[:, max_idx]\n","\n","    if beta_1 <= tol:\n","        return None\n","\n","    s = np.where(u_1 >0, 1.0, -1.0)\n","    if np.all(s == 1.0) or np.all(s == -1.0):\n","        return None\n","\n","    def calc_dq(state):\n","        return float(state @ B_sub @ state) / (4.0 * m_total)\n","\n","    best_s = s.copy()\n","    best_dq = calc_dq(best_s)\n","    improved = True\n","\n","    while improved:\n","        improved = False\n","        unmoved = set(range(n_g))\n","        curr_s = best_s.copy()\n","        step_best_dq = best_dq\n","\n","        while unmoved:\n","            best_node = None\n","            best_candidate_dq = -np.inf\n","            for i in unmoved:\n","                curr_s.put(i, -curr_s.item(i))\n","                dq = calc_dq(curr_s)\n","                if dq > best_candidate_dq:\n","                    best_candidate_dq = dq\n","                    best_node = i\n","                curr_s.put(i, -curr_s.item(i))\n","\n","            curr_s.put(best_node, -curr_s.item(best_node))\n","            unmoved.remove(best_node)\n","\n","            if best_candidate_dq > step_best_dq + tol:\n","                step_best_dq = best_candidate_dq\n","                best_s = curr_s.copy()\n","                improved = True\n","\n","        if improved:\n","            best_dq = step_best_dq\n","\n","    if best_dq <= tol or np.all(best_s == 1.0) or np.all(best_s == -1.0):\n","        return None\n","\n","    g1 = list(val for val, sign in zip(sub_indices, best_s) if sign > 0)\n","    g2 = list(val for val, sign in zip(sub_indices, best_s) if sign < 0)\n","    return g1, g2, best_dq\n","\n","\n","def recursive_spectral_partition(G, B_global, m_total, tol=1e-8):\n","    communities = list((list(G.nodes()),))\n","    queue = list((0,))\n","\n","    G_work = G.copy()\n","    current_q = nx.community.modularity(G, communities)\n","    history = list((\n","        dict(\n","            iteration=0,\n","            description=\"Initial Graph (1 Community)\",\n","            communities=list(list(c) for c in communities),\n","            graph=G_work.copy(),\n","            modularity=current_q\n","        ),\n","    ))\n","\n","    iteration = 0\n","    while queue:\n","        comm_idx = queue.pop(0)\n","        target_comm = communities.copy().pop(comm_idx)\n","        result = spectral_bisect(target_comm, B_global, m_total, tol=tol)\n","\n","        if result is not None:\n","            g1, g2, dq = result\n","\n","            # Test candidate partition and accept ONLY if global modularity strictly increases\n","            candidate_comms = list(list(c) for c in communities)\n","            candidate_comms.pop(comm_idx)\n","            candidate_comms.insert(comm_idx, g1)\n","            new_idx = len(candidate_comms)\n","            candidate_comms.append(g2)\n","\n","            new_q = nx.community.modularity(G, candidate_comms)\n","            if new_q > current_q + tol:\n","                iteration += 1\n","                communities = candidate_comms\n","                current_q = new_q\n","                queue.extend((comm_idx, new_idx))\n","\n","                cut_edges = list((u, v) for u in g1 for v in g2 if G_work.has_edge(u, v))\n","                G_work.remove_edges_from(cut_edges)\n","\n","                history.append(dict(\n","                    iteration=iteration,\n","                    description=f\"After Split {iteration} ({len(communities)} Communities)\",\n","                    communities=list(list(c) for c in communities),\n","                    graph=G_work.copy(),\n","                    modularity=current_q\n","                ))\n","\n","    return history\n","\n","\n","split_history = recursive_spectral_partition(G_orig, B, m)\n","for step in split_history:\n","    print(f\"Iteration {step.get('iteration')}: {step.get('description')} | Q = {step.get('modularity'):.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SIwkIR7p6Lgd","executionInfo":{"status":"ok","timestamp":1795446618589,"user_tz":-330,"elapsed":49,"user":{"displayName":"Ritheesh","userId":"16825785188976750571"}},"outputId":"6ec8fec6-91c9-482b-98da-c9efabe9079f"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["Iteration 0: Initial Graph (1 Community) | Q = 0.0000\n","Iteration 1: After Split 1 (2 Communities) | Q = 0.4036\n","Iteration 2: After Split 2 (3 Communities) | Q = 0.4173\n"]}]},{"cell_type":"code","source":["num_steps = len(split_history)\n","cols = 2\n","rows = (num_steps + 1) // 2\n","\n","fig, axes = plt.subplots(rows, cols, figsize=(12, 5 * rows))\n","axes = np.atleast_1d(axes).flatten()\n","\n","cmap = plt.get_cmap(\"Set2\")\n","\n","for ax, step in zip(axes, split_history):\n","    node_to_comm = {}\n","    for c_id, comm in enumerate(step.get(\"communities\")):\n","        for node in comm:\n","            node_to_comm.update({node: c_id})\n","\n","    node_colors = list(cmap(node_to_comm.get(n)) for n in G_orig.nodes())\n","\n","    nx.draw_networkx_edges(G_orig, pos, ax=ax, edge_color=\"#e0e0e0\", style=\"dashed\", width=0.9)\n","    nx.draw_networkx_edges(step.get(\"graph\"), pos, ax=ax, edge_color=\"#444444\", width=1.4)\n","    nx.draw_networkx_nodes(G_orig, pos, ax=ax, node_color=node_colors, node_size=360, edgecolors=\"black\")\n","    nx.draw_networkx_labels(G_orig, pos, ax=ax, font_size=8.5, font_weight=\"bold\")\n","\n","    ax.set_title(f\"{step.get('description')}\\nModularity Q = {step.get('modularity'):.4f}\", fontsize=11, fontweight=\"bold\")\n","    ax.axis(\"off\")\n","\n","# Hide any unused subplot slots\n","for ax in axes.tolist()[num_steps:]:\n","    ax.axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":264},"id":"y1TR8wZw6YfW","executionInfo":{"status":"ok","timestamp":1795446624534,"user_tz":-330,"elapsed":1275,"user":{"displayName":"Ritheesh","userId":"16825785188976750571"}},"outputId":"fa043000-9212-427a-e6b1-f84f24eb0104"},"execution_count":21,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x1000 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["metric_records = []\n","\n","for step in split_history:\n","    it = step.get(\"iteration\")\n","    G_curr = step.get(\"graph\")\n","\n","    deg_c = nx.degree_centrality(G_curr)\n","    bet_c = nx.betweenness_centrality(G_curr)\n","    clo_c = nx.closeness_centrality(G_curr)\n","    clust = nx.clustering(G_curr)\n","\n","    for node in nodes:\n","        metric_records.append(dict(\n","            iteration=it,\n","            node=node,\n","            degree_centrality=deg_c.get(node),\n","            betweenness_centrality=bet_c.get(node),\n","            closeness_centrality=clo_c.get(node),\n","            clustering=clust.get(node),\n","        ))\n","\n","metrics_df = pd.DataFrame(metric_records)\n","\n","final_it = split_history.copy().pop().get(\"iteration\")\n","final_df = metrics_df.query(\"iteration == @final_it\").set_index(\"node\")\n","print(f\"=== Top 5 Nodes per Metric at Final Split (Iteration {final_it}) ===\")\n","for col in (\"degree_centrality\", \"betweenness_centrality\", \"closeness_centrality\", \"clustering\"):\n","    top5 = final_df.get(col).nlargest(5)\n","    formatted = \", \".join(f\"Node {idx} ({val:.3f})\" for idx, val in top5.items())\n","    print(f\"{col:24s}: {formatted}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"sNZIntnM64sb","executionInfo":{"status":"ok","timestamp":1795446628591,"user_tz":-330,"elapsed":26,"user":{"displayName":"Ritheesh","userId":"16825785188976750571"}},"outputId":"137d20ca-c059-4a63-b173-ec24d8989f37"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Top 5 Nodes per Metric at Final Split (Iteration 2) ===\n","degree_centrality       : Node 33 (0.455), Node 32 (0.333), Node 0 (0.242), Node 3 (0.152), Node 23 (0.152)\n","betweenness_centrality  : Node 33 (0.147), Node 32 (0.052), Node 0 (0.051), Node 31 (0.029), Node 23 (0.016)\n","closeness_centrality    : Node 33 (0.461), Node 32 (0.381), Node 23 (0.302), Node 31 (0.302), Node 27 (0.283)\n","clustering              : Node 7 (1.000), Node 8 (1.000), Node 13 (1.000), Node 14 (1.000), Node 15 (1.000)\n"]}]},{"cell_type":"code","source":["metrics_info = (\n","    (\"degree_centrality\", \"Degree Centrality\"),\n","    (\"betweenness_centrality\", \"Betweenness Centrality\"),\n","    (\"closeness_centrality\", \"Closeness Centrality\"),\n","    (\"clustering\", \"Clustering Coefficient\"),\n",")\n","\n","highlight_nodes = {\n","    0: (\"Node 0 (Mr. Hi)\", \"#d62728\"),\n","    33: (\"Node 33 (John A.)\", \"#1f77b4\"),\n","    32: (\"Node 32\", \"#2ca02c\"),\n","    2: (\"Node 2\", \"#ff7f0e\"),\n","    1: (\"Node 1\", \"#9467bd\"),\n","}\n","\n","fig, axes = plt.subplots(2, 2, figsize=(14, 9), sharex=True)\n","axes_list = axes.flatten().tolist()\n","iterations = sorted(metrics_df.get(\"iteration\").unique())\n","\n","for ax, (col, title) in zip(axes_list, metrics_info):\n","    for node in nodes:\n","        if node not in highlight_nodes:\n","            node_data = metrics_df.query(\"node == @node\")\n","            ax.plot(\n","                node_data.get(\"iteration\"),\n","                node_data.get(col),\n","                color=\"gray\",\n","                alpha=0.35,\n","                linewidth=1.0,\n","                marker=\"o\",\n","                markersize=3,\n","            )\n","\n","    for node, (label, color) in highlight_nodes.items():\n","        node_data = metrics_df.query(\"node == @node\")\n","        ax.plot(\n","            node_data.get(\"iteration\"),\n","            node_data.get(col),\n","            label=label,\n","            color=color,\n","            linewidth=2.2,\n","            marker=\"o\",\n","            markersize=6,\n","        )\n","\n","    ax.set_title(f\"Evolution of {title}\", fontsize=11, fontweight=\"bold\")\n","    ax.set_ylabel(title, fontsize=10)\n","    ax.set_xticks(iterations)\n","    ax.set_xticklabels(list(f\"Iter {i}\" for i in iterations))\n","    ax.grid(True, linestyle=\"--\", alpha=0.4)\n","\n","axes_list.pop(2).set_xlabel(\"Partitioning Iteration\", fontsize=10)\n","ax_br = axes_list.pop()\n","ax_br.set_xlabel(\"Partitioning Iteration\", fontsize=10)\n","ax_br.legend(loc=\"upper right\", fontsize=8.5, framealpha=0.9)\n","\n","plt.suptitle(\"Node-Level Metric Evolution Across Spectral Modularity Splits (All 34 Nodes)\", fontsize=13, fontweight=\"bold\")\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":207},"id":"HoENAXHU67h3","executionInfo":{"status":"ok","timestamp":1795446633020,"user_tz":-330,"elapsed":1566,"user":{"displayName":"Ritheesh","userId":"16825785188976750571"}},"outputId":"ab23b98c-9fc7-4106-c66c-d5ce716c685c"},"execution_count":23,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x900 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### Discussion: Centrality Persistence and Community Structure Effects\n","\n","1. **Consistently Central Nodes:**\n","   * **Node 33 (John A.)** and **Node 0 (Mr. Hi)** consistently remain the top hubs across splits. Because John A.'s green community (16 nodes) remains unified through Iteration 2, **Node 33** retains its full internal degree, highest closeness, and highest betweenness at the final partition ($Q = 0.4173$).\n","   * **Node 32** (within John A.'s faction) and **Node 1** / **Node 2** (within the orange sub-community of Mr. Hi's faction) also maintain high local centrality within their respective subgroups.\n","\n","2. **How Community Structure Influences Each Metric:**\n","   * **Degree Centrality:** Decreases modestly after splits, primarily for boundary nodes (such as **Node 0**, **Node 2**, and **Node 8**) that bridged the two main factions or the two sub-clusters of Mr. Hi's group. Internal core nodes lose few or no edges.\n","   * **Betweenness Centrality:** Shows the sharpest drop for bridge nodes. In **Iter 0**, **Node 0** and **Node 2** have high betweenness because shortest paths connecting the two halves of the club pass through them. After **Split 1** and **Split 2** sever inter-community links, cross-community shortest paths vanish—causing **Node 0** and **Node 2** to drop sharply while **Node 33** remains dominant inside its large intact faction.\n","   * **Closeness Centrality:** Decreases step-by-step across all nodes because `nx.closeness_centrality` scales scores by the fraction of reachable nodes in disconnected components ($\\frac{n_c - 1}{N - 1}$). Consequently, nodes in the largest remaining component (John A.'s 16-node green community) retain higher closeness than nodes in the smaller split subgroups.\n","   * **Clustering Coefficient:** Increases for boundary nodes (notably **Node 1** and **Node 2** in the bottom-right plot) after partitioning. Removing sparse cross-community edges eliminates \"open wedges\" spanning different communities, leaving denser, tightly knit local triangles."],"metadata":{"id":"EbOCebVq8t-C"}}]}